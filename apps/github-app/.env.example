# Your GitHub App (settings → developer settings → GitHub Apps).
APP_ID=<your_github_app_id>
# Private key of the GitHub App. Keep the \n as literal backslash-n — the app
# converts them to real newlines at boot.
PRIVATE_KEY=<paste the contents of your .pem file here>
# Webhook secret configured on the GitHub App.
WEBHOOK_SECRET=<your_github_app_webhook_secret>

# Local dev only: Probot forwards webhook events here (https://smee.io/new).
WEBHOOK_PROXY_URL=

# GitHub OAuth App credentials used for the sign-in flow.
GITHUB_CLIENT_ID=<your_github_oauth_app_client_id>
GITHUB_CLIENT_SECRET=<your_github_oauth_app_client_secret>

# Rio Postgres/Redis (same as the root .env).
DATABASE_URL=postgres://rio:rio@localhost:5432/rio
REDIS_URL=redis://localhost:6379

# Port the app listens on.
PORT=3000

# Use `trace` for verbose logging or `info` for less.
LOG_LEVEL=debug