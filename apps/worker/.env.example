APP_ID=<copy from github-app/.env>
PRIVATE_KEY=<copy from github-app/.env>
# Shared secret with ai-engine, authenticating the worker as a trusted
# internal caller (not a per-user Rio API key) for the /v1/review BYOK path.
# Generate with `openssl rand -base64 32`. Must match ai-engine's
# INTERNAL_SERVICE_TOKEN exactly.
INTERNAL_SERVICE_TOKEN=<generate with `openssl rand -base64 32`, must match ai-engine>

