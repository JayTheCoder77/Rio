DATABASE_URL=your_neon_connection_string_here
REDIS_URL=redis://localhost:<your_port_here>
PINECONE_API_KEY=<your_pinecone_api_key_here>
PINECONE_INDEX_NAME=(default=rio)
# Token the worker sends to ai-engine to authenticate as a trusted internal
# caller (the BYOK /v1/review path) rather than a per-user API key. Generate
# with `openssl rand -base64 32`. Must match INTERNAL_SERVICE_TOKEN in
# apps/worker/.env exactly.
INTERNAL_SERVICE_TOKEN=<generate with `openssl rand -base64 32`>
# Key used to encrypt per-user LLM provider keys (BYOK) at rest in Postgres.
# Generate with `openssl rand -hex 32`. Needed by ai-engine and the web
# dashboard (settings page stores provider keys).
ENCRYPTION_KEY=<generate with `openssl rand -hex 32`>
# Optional: max diff size (chars) the ai-engine will review. Defaults to 40000.
# Set lower (e.g. 20000) in prod to keep review cost bounded. Exceeding it
# returns a clean 422, not a 500.
MAX_DIFF_CHARS=40000
NOMIC_API_KEY